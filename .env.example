# GEMINI_API_KEY: Required for Gemini AI Coach streaming responses.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL Runtime Credentials (injected in production / local proxy)
SQL_HOST="/cloudsql/PROJECT:REGION:INSTANCE"
SQL_DB_NAME="meridian_academy"
SQL_USER="app_user"
SQL_PASSWORD="CHANGE_ME_APP_PASSWORD"

# Cloud SQL Admin Credentials for Drizzle Kit migrations
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="CHANGE_ME_ADMIN_PASSWORD"

# Redis Cache & Rate Limiting (used in Docker Compose / production)
REDIS_URL="redis://localhost:6379"

# JWT & Cryptographic Signing Secrets (generate strong 256-bit secrets in production)
JWT_SECRET="CHANGE_ME_JWT_SECRET"
CERTIFICATE_HMAC_SECRET="CHANGE_ME_CERTIFICATE_HMAC_SECRET"
MEDIA_SIGNING_SECRET="CHANGE_ME_MEDIA_SIGNING_SECRET"

# AWS S3 & CloudFront Media Service (for instructor video uploads & 15-min signed URLs)
AWS_REGION="eu-west-2"
AWS_S3_BUCKET="meridian-academy-media"
AWS_ACCESS_KEY_ID="MY_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="MY_AWS_SECRET_ACCESS_KEY"
CLOUDFRONT_DOMAIN=""
